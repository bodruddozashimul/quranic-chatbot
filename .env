# ─── Language model ────────────────────────────────────────────────
# Ollama runs on Windows itself, not in a container. See docker-compose.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model choice, in order of preference for an 8 GB machine:
#   qwen2.5:3b-instruct-q4_K_M   ~2.0 GB   best quality that still fits  <-- default
#   qwen2.5:1.5b-instruct-q4_K_M ~1.0 GB   fastest, use if 3b feels slow
#   gemma2:2b-instruct-q4_K_M    ~1.6 GB   alternative if Bengali reads poorly
#   qwen2:7b                     ~4.4 GB   the model in the report; will swap badly here
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

TEMPERATURE=0.2
NUM_PREDICT=220
NUM_CTX=2048
LLM_TIMEOUT=180

# ─── Retrieval ─────────────────────────────────────────────────────
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_THREADS=2
TOP_K=3

# Out-of-scope gate. Below this cosine similarity, nothing is returned and the
# system refuses. Raise it if irrelevant verses appear; lower it if valid
# questions are being refused. Measure with eval/run_eval.py, do not guess.
SIM_THRESHOLD=0.35

# Lexical fusion. Off by default: on paraphrased questions BM25 alone reaches
# only ~0.17 Hit@3, so it helps mainly on quoted wording. Turn on to produce
# the ablation row for your report.
USE_HYBRID=false
BM25_WEIGHT=0.3

# ─── Vector store ──────────────────────────────────────────────────
COLLECTION_NAME=quran_ayahs
