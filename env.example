# Quran RAG configuration
# Default setup: Ollama runs natively on the Windows host.
# The Docker backend reaches it through host.docker.internal.

# ── Language model ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

TEMPERATURE=0.2
NUM_PREDICT=220
NUM_CTX=2048
LLM_TIMEOUT=180

# ── Retrieval / embeddings ──────────────────────────────────────────
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_THREADS=2
TOP_K=3

# Minimum cosine similarity for accepting a retrieved result.
# Tune against the evaluation dataset rather than guessing.
SIM_THRESHOLD=0.35

# Optional lexical + vector retrieval fusion.
USE_HYBRID=false
BM25_WEIGHT=0.3

# ── ChromaDB ────────────────────────────────────────────────────────
COLLECTION_NAME=quran_ayahs
